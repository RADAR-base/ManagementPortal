<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Source type descriptions are imported from the catalogue server (the RADAR-Schemas `doc`
        field), which can be longer than 255 characters.
    -->
    <changeSet id="20260924120000-1" author="pim@thehyve.nl">
        <modifyDataType tableName="source_type" columnName="description" newDataType="varchar(2048)"/>
    </changeSet>
    <changeSet id="20260924120000-2" author="pim@thehyve.nl">
        <modifyDataType tableName="source_type_aud" columnName="description" newDataType="varchar(2048)"/>
    </changeSet>
</databaseChangeLog>
